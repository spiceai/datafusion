statement ok
CREATE TABLE test(
  s TEXT
) as VALUES
  ('p1'),
  ('p1e1'),
  ('p1m1e1'),
  ('P1'),
  ('P1e1'),
  ('P1m1e1'),
  ('e1'),
  ('p2'),
  ('p2e1'),
  ('p2m1e1')
;

# LIKE
query T rowsort
SELECT s FROM test WHERE s LIKE 'p1%';
----
p1
p1e1
p1m1e1

query T rowsort
SELECT s FROM test WHERE s LIKE '%m1%';
----
P1m1e1
p1m1e1
p2m1e1

# REGEX
query T rowsort
SELECT s FROM test WHERE s ~ 'p[12].*';
----
p1
p1e1
p1m1e1
p2
p2e1
p2m1e1

# REGEX nocase
query T rowsort
SELECT s FROM test WHERE s ~* 'p[12].*';
----
P1
P1e1
P1m1e1
p1
p1e1
p1m1e1
p2
p2e1
p2m1e1

# SIMILAR TO with `%` wildcard (zero or more characters)
query T rowsort
SELECT s FROM test WHERE s SIMILAR TO 'p1%';
----
p1
p1e1
p1m1e1

# SIMILAR TO with `_` wildcard (exactly one character)
query T rowsort
SELECT s FROM test WHERE s SIMILAR TO 'p_';
----
p1
p2

# SIMILAR TO requires full-string match (no implicit substring)
query T rowsort
SELECT s FROM test WHERE s SIMILAR TO 'p1';
----
p1

# SIMILAR TO treats `. ^ $` as SQL literals (not as regex metachars).
query B
SELECT 'a.' SIMILAR TO 'a.';
----
true

query B
SELECT 'ab' SIMILAR TO 'a.';
----
false

query B
SELECT '^x$' SIMILAR TO '^x$';
----
true

query B
SELECT 'x' SIMILAR TO '^x$';
----
false

# SIMILAR TO supports the POSIX metacharacters `| * + ? ( ) { } [ ]`.
query B
SELECT 'a' SIMILAR TO 'a|b';
----
true

query B
SELECT 'c' SIMILAR TO 'a|b';
----
false

query B
SELECT '' SIMILAR TO 'a*';
----
true

query B
SELECT 'aa' SIMILAR TO 'a*';
----
true

query B
SELECT 'ab' SIMILAR TO 'a*';
----
false

query B
SELECT 'a' SIMILAR TO 'a+';
----
true

query B
SELECT '' SIMILAR TO 'a+';
----
false

query B
SELECT '' SIMILAR TO 'a?';
----
true

query B
SELECT 'a' SIMILAR TO 'a?';
----
true

query B
SELECT 'aa' SIMILAR TO 'a?';
----
false

query B
SELECT 'ab' SIMILAR TO '(ab)';
----
true

query B
SELECT 'a' SIMILAR TO 'a{2}';
----
false

query B
SELECT 'aa' SIMILAR TO 'a{2}';
----
true

query B
SELECT 'a' SIMILAR TO '[ab]';
----
true

query B
SELECT 'c' SIMILAR TO '[ab]';
----
false

query B
SELECT 'c' SIMILAR TO '[^ab]';
----
true

query B
SELECT 'a' SIMILAR TO '[^ab]';
----
false

# SIMILAR TO wildcards match newlines.
query B
SELECT 'a' || chr(10) || 'b' SIMILAR TO 'a%b';
----
true

query B
SELECT 'a' || chr(10) || 'b' SIMILAR TO 'a_b';
----
true

query B
SELECT 'ab' SIMILAR TO 'a_b';
----
false

# SIMILAR TO with a dynamic (column) pattern: wildcards and regex-only
# metacharacters are translated the same way as for literal patterns.
statement ok
CREATE TABLE dynamic_patterns(text TEXT, pattern TEXT) AS VALUES
  ('abc', 'a%'),
  ('ab', 'a.'),
  ('x', '_'),
  ('hello world', 'hello%');

query T rowsort
SELECT text FROM dynamic_patterns WHERE text SIMILAR TO pattern;
----
abc
hello world
x

query T rowsort
SELECT text FROM dynamic_patterns WHERE text NOT SIMILAR TO pattern;
----
ab

statement ok
DROP TABLE dynamic_patterns;

# SIMILAR TO with a dynamic pattern produced by a function.
query B
SELECT 'abc' SIMILAR TO concat('a', '%');
----
true

query B
SELECT 'ab' SIMILAR TO concat('a', '.');
----
false

query B
SELECT 'x' SIMILAR TO lower('X');
----
true

query B
SELECT 'X' SIMILAR TO lower('X');
----
false

# NOT SIMILAR TO with a literal pattern.
query T rowsort
SELECT s FROM test WHERE s NOT SIMILAR TO 'p1%';
----
P1
P1e1
P1m1e1
e1
p2
p2e1
p2m1e1

# SIMILAR TO NULL pattern returns NULL.
query B
SELECT 'a' SIMILAR TO NULL;
----
NULL

# SIMILAR TO with a non-string pattern is rejected by the analyzer.
statement error There isn't a common type to coerce Utf8 and Int64 in SIMILAR TO expression
SELECT 'a' SIMILAR TO 1;

# The value and the pattern are coerced to a common string type, so mixing
# `Utf8`, `LargeUtf8` and `Utf8View` works instead of failing in the regex
# kernel.
query B
SELECT 'abc' SIMILAR TO arrow_cast('a%', 'LargeUtf8');
----
true

query B
SELECT arrow_cast('ab', 'Utf8View') SIMILAR TO arrow_cast('a.', 'LargeUtf8');
----
false

query B
SELECT arrow_cast('a', 'Utf8View') SIMILAR TO NULL;
----
NULL

query B
SELECT arrow_cast('a', 'LargeUtf8') SIMILAR TO arrow_cast(NULL, 'Utf8View');
----
NULL

statement ok
CREATE TABLE mixed_patterns(text TEXT, pattern TEXT) AS VALUES ('abc', 'a%');

query B
SELECT text SIMILAR TO arrow_cast(pattern, 'LargeUtf8') FROM mixed_patterns;
----
true

query B
SELECT arrow_cast(text, 'Utf8View') SIMILAR TO arrow_cast(pattern, 'LargeUtf8')
FROM mixed_patterns;
----
true

# Dictionary-encoded values are coerced to their value type.
query B
SELECT arrow_cast(text, 'Dictionary(Int32, Utf8)') SIMILAR TO 'a%'
FROM mixed_patterns;
----
true

query B
SELECT arrow_cast(text, 'Dictionary(Int32, Utf8)') SIMILAR TO pattern
FROM mixed_patterns;
----
true

statement ok
DROP TABLE mixed_patterns;

# SIMILAR TO: `\` is the default escape character, so an escaped wildcard,
# metacharacter or backslash matches only itself.
query BBBBBB
SELECT 'a%' SIMILAR TO 'a\%', 'ab' SIMILAR TO 'a\%', 'a_' SIMILAR TO 'a\_',
  'ab' SIMILAR TO 'a\_', 'a\b' SIMILAR TO 'a\\b', 'a|b' SIMILAR TO 'a\|b';
----
true false true false true true

# SIMILAR TO: the `]` that closes a named class such as `[:digit:]` does not
# close the bracket expression around it, and characters that are set
# operators in the regex engine (`&&`, `~~`) are literal.
query BBBBBB
SELECT '_' SIMILAR TO '[[:digit:]_]', '5' SIMILAR TO '[[:digit:]_]',
  's' SIMILAR TO '[[:digit:]_]', '&' SIMILAR TO '[a&&b]',
  '~' SIMILAR TO '[a~~b]', 'c' SIMILAR TO '[a&&b]';
----
true true false true true false

# The same patterns from a column.
statement ok
CREATE TABLE similar_to_cases(value TEXT, pattern TEXT) AS VALUES
  ('a%', 'a\%'),
  ('ab', 'a\%'),
  ('a_', 'a\_'),
  ('a\b', 'a\\b'),
  ('_', '[[:digit:]_]'),
  ('s', '[[:digit:]_]'),
  ('&', '[a&&b]'),
  ('c', '[a&&b]');

query TTB rowsort
SELECT value, pattern, value SIMILAR TO pattern FROM similar_to_cases;
----
& [a&&b] true
_ [[:digit:]_] true
a% a\% true
a\b a\\b true
a_ a\_ true
ab a\% false
c [a&&b] false
s [[:digit:]_] false

statement ok
DROP TABLE similar_to_cases;

# SIMILAR TO rejects a pattern with unbalanced parentheses, which would
# otherwise let `|` take apart the anchors around the pattern.
statement ok
CREATE TABLE similar_to_invalid(value TEXT, pattern TEXT) AS VALUES ('ax', 'a)|b(');

query error Invalid SIMILAR TO pattern 'a\)\|b\(': parentheses \(\) not balanced
SELECT value SIMILAR TO 'a)|b(' FROM similar_to_invalid;

query error Invalid SIMILAR TO pattern 'a\)\|b\(': parentheses \(\) not balanced
SELECT value SIMILAR TO pattern FROM similar_to_invalid;

statement ok
DROP TABLE similar_to_invalid;

# A pattern that is not valid fails only where it is matched against a value,
# as in PostgreSQL: not in a CASE branch no row takes, and not in a row whose
# value is NULL.
query B
SELECT CASE WHEN v = 'zzz' THEN v SIMILAR TO '[' END FROM (VALUES ('a'), ('b')) t(v);
----
NULL
NULL

query error Invalid SIMILAR TO pattern '\[': brackets \[\] not balanced
SELECT CASE WHEN v = 'a' THEN v SIMILAR TO '[' END FROM (VALUES ('a'), ('b')) t(v);

query B rowsort
SELECT v SIMILAR TO p FROM (VALUES (CAST(NULL AS VARCHAR), '['), ('a', 'a')) t(v, p);
----
NULL
true

# NOT LIKE
query T rowsort
SELECT s FROM test WHERE s NOT LIKE 'p1%';
----
P1
P1e1
P1m1e1
e1
p2
p2e1
p2m1e1


# ILIKE
query T rowsort
SELECT s FROM test WHERE s ILIKE 'p1%';
----
P1
P1e1
P1m1e1
p1
p1e1
p1m1e1

query T rowsort
SELECT s FROM test WHERE s ILIKE 'p1';
----
P1
p1

# NOT ILIKE
query T rowsort
SELECT s FROM test WHERE s NOT ILIKE 'p1%';
----
e1
p2
p2e1
p2m1e1

## VARCHAR with length support

# Lengths can be used by default
query T
SELECT '12345'::VARCHAR(2);
----
12345

# Lengths can not be used when the config setting is disabled

statement ok
set datafusion.sql_parser.support_varchar_with_length = false;

query error
SELECT '12345'::VARCHAR(2);

query error
SELECT s::VARCHAR(2) FROM (VALUES ('12345')) t(s);

statement ok
create table vals(s char) as values('abc'), ('def');

query error
SELECT s::VARCHAR(2) FROM vals

# Lengths can be used when the config setting is enabled

statement ok
set datafusion.sql_parser.support_varchar_with_length = true;

query T
SELECT '12345'::VARCHAR(2)
----
12345

query T
SELECT s::VARCHAR(2) FROM (VALUES ('12345')) t(s)
----
12345

query T
SELECT s::VARCHAR(2) FROM vals
----
abc
def

statement ok
drop table vals;
