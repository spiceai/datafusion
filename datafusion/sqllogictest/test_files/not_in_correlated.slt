# `NOT IN (subquery)` in a WHERE clause: uncorrelated, and correlated by an
# equality, a non-equality or both, over data that puts NULLs in the outer
# value, the subquery's values and the correlation keys. The expected rows are
# SQLite's, which follows SQL three-valued logic.

# nisc_t1(id, g) = (1, 1), (2, 2), (3, NULL); nisc_t2(id, g) = (1, 3), (2, 1)
statement ok
CREATE TABLE nisc_t1(id INT, g INT) AS VALUES (1, 1), (2, 2), (3, NULL);

statement ok
CREATE TABLE nisc_t2(id INT, g INT) AS VALUES (1, 3), (2, 1);

# constant, uncorrelated
query I rowsort
SELECT id FROM nisc_t1 WHERE 3 NOT IN (SELECT id FROM nisc_t2)
----
1
2
3

# column, uncorrelated
query I rowsort
SELECT id FROM nisc_t1 WHERE nisc_t1.id NOT IN (SELECT id FROM nisc_t2)
----
3

# constant, equality correlation
query I rowsort
SELECT id FROM nisc_t1 WHERE 3 NOT IN (SELECT nisc_t2.id FROM nisc_t2 WHERE nisc_t2.g = nisc_t1.g)
----
1
2
3

# column, equality correlation
query I rowsort
SELECT id FROM nisc_t1 WHERE nisc_t1.id NOT IN (SELECT nisc_t2.id FROM nisc_t2 WHERE nisc_t2.g = nisc_t1.g)
----
1
2
3

# constant, non-equality correlation
query I rowsort
SELECT id FROM nisc_t1 WHERE 3 NOT IN (SELECT nisc_t2.id FROM nisc_t2 WHERE nisc_t2.g > nisc_t1.g)
----
1
2
3

# column, non-equality correlation
query I rowsort
SELECT id FROM nisc_t1 WHERE nisc_t1.id NOT IN (SELECT nisc_t2.id FROM nisc_t2 WHERE nisc_t2.g > nisc_t1.g)
----
2
3

# column, mixed correlation
query I rowsort
SELECT id FROM nisc_t1 WHERE nisc_t1.id NOT IN (SELECT nisc_t2.id FROM nisc_t2 WHERE nisc_t2.g = nisc_t1.g AND nisc_t2.id > nisc_t1.g)
----
1
2
3

# NULL constant, equality correlation
query I rowsort
SELECT id FROM nisc_t1 WHERE CAST(NULL AS INT) NOT IN (SELECT nisc_t2.id FROM nisc_t2 WHERE nisc_t2.g = nisc_t1.g)
----
2
3

# IN, equality correlation
query I rowsort
SELECT id FROM nisc_t1 WHERE nisc_t1.id IN (SELECT nisc_t2.id FROM nisc_t2 WHERE nisc_t2.g = nisc_t1.g)
----

statement ok
DROP TABLE nisc_t1;

statement ok
DROP TABLE nisc_t2;

