# A subquery filter equal to the `IN` comparison keeps only values equal to the
# outer value, none of them NULL, so the NULL in nisd_b must not reach the join.
statement ok
CREATE TABLE nisd_a(id INT, x INT, g INT) AS VALUES (1, NULL, 1), (2, 7, 1), (3, 9, 2), (4, 1, 1);

statement ok
CREATE TABLE nisd_b(y INT, g INT) AS VALUES (1, 1), (NULL, 1);

query I rowsort
SELECT id FROM nisd_a WHERE x NOT IN (SELECT y FROM nisd_b WHERE y = nisd_a.x AND nisd_b.g = nisd_a.g)
----
1
2
3

query I rowsort
SELECT id FROM nisd_a WHERE x NOT IN (SELECT y FROM nisd_b WHERE y = nisd_a.x)
----
1
2
3

# A scalar aggregate that the decorrelation groups by the correlation has no row
# for an outer row without a group, where the subquery returns the aggregate
# over no input. These keep the null-aware plan, which does not support them,
# rather than answer from the missing rows.
statement ok
CREATE TABLE nisd_c(y INT, g INT) AS VALUES (4, 1);

query error null_aware anti join only supports single column join key
SELECT id FROM nisd_a WHERE x NOT IN (SELECT SUM(y) FROM nisd_c WHERE nisd_c.g = nisd_a.g)

query error null_aware anti join only supports single column join key
SELECT id FROM nisd_a WHERE x NOT IN (SELECT COUNT(*) FROM nisd_c WHERE nisd_c.g = nisd_a.g)

statement ok
DROP TABLE nisd_a;

statement ok
DROP TABLE nisd_b;

statement ok
DROP TABLE nisd_c;
