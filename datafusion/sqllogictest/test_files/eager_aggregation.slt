# Eager aggregation pushes a partial aggregate below a join and merges it above
# the join. An ungrouped COUNT merges its partial counts with SUM, which is NULL
# when the join emits no rows, while COUNT over no rows is 0. These run the
# rewrite through the full physical optimizer, where a projection above the
# aggregate (`count(Int64(1)) AS count(*)`) is planned before the rule runs.

statement ok
set datafusion.optimizer.enable_eager_aggregation = true;

statement ok
set datafusion.explain.physical_plan_only = true;

# `qty` has 17 values and every tenth row is NULL. The `IN` filter tells the
# rule's cost gate how many distinct values each query groups by.
statement ok
CREATE TABLE t AS
SELECT value AS id,
       CASE WHEN value % 10 = 0 THEN NULL ELSE CAST(value % 17 - 8 AS INT) END AS qty
FROM generate_series(1, 20000);

statement ok
CREATE TABLE d AS SELECT CAST(value AS INT) AS k FROM generate_series(1, 3);

# The rule fires on a NOT IN whose subquery yields a NULL: a partial count
# grouped by `qty` sits below the null-aware anti join.
query TT
EXPLAIN SELECT count(*) FROM t WHERE qty IN (1, 2, 3) AND qty NOT IN (SELECT NULL::INT);
----
physical_plan
01)ProjectionExec: expr=[CASE WHEN __eager_m0_0@0 IS NOT NULL THEN __eager_m0_0@0 ELSE 0 END as count(*)]
02)--AggregateExec: mode=Final, gby=[], aggr=[__eager_m0_0]
03)----CoalescePartitionsExec
04)------AggregateExec: mode=Partial, gby=[], aggr=[__eager_m0_0]
05)--------RepartitionExec: partitioning=RoundRobinBatch(4), input_partitions=1
06)----------HashJoinExec: mode=CollectLeft, join_type=LeftAnti, accumulator=MinMaxLeftAccumulator, on=[(qty@0, NULL@0)], null_aware
07)------------CoalescePartitionsExec
08)--------------AggregateExec: mode=FinalPartitioned, gby=[qty@0 as qty], aggr=[__eager_p0_0]
09)----------------RepartitionExec: partitioning=Hash([qty@0], 4), input_partitions=4
10)------------------AggregateExec: mode=Partial, gby=[qty@0 as qty], aggr=[__eager_p0_0]
11)--------------------FilterExec: qty@0 = 1 OR qty@0 = 2 OR qty@0 = 3
12)----------------------DataSourceExec: partitions=4, partition_sizes=[1, 1, 1, 0]
13)------------ProjectionExec: expr=[NULL]
14)--------------PlaceholderRowExec

# A NULL in the subquery empties the null-aware anti join, so every count is 0.
query I
SELECT count(*) FROM t WHERE qty IN (1, 2, 3) AND qty NOT IN (SELECT NULL::INT);
----
0

query I
SELECT count(id) FROM t WHERE qty IN (1, 2, 3) AND qty NOT IN (SELECT NULL::INT);
----
0

query I
SELECT count(*) FROM t WHERE qty IN (1, 2, 3) AND qty NOT IN (SELECT qty FROM t WHERE id <= 50);
----
0

query I
SELECT coalesce(count(*), 42) FROM t WHERE qty IN (1, 2, 3) AND qty NOT IN (SELECT NULL::INT);
----
0

# The same rewrite over an anti join that keeps rows still counts them.
query II
SELECT count(*), count(id) FROM t WHERE qty IN (1, 2, 3) AND qty NOT IN (SELECT qty FROM t WHERE id <= 9);
----
2117 2117

# A plain ungrouped count(*) over a semi join, which the rule rewrites the same
# way, with and without rows surviving the join.
query TT
EXPLAIN SELECT count(*) FROM t WHERE qty IN (1, 2, 3) AND qty IN (SELECT k FROM d);
----
physical_plan
01)ProjectionExec: expr=[CASE WHEN __eager_m0_0@0 IS NOT NULL THEN __eager_m0_0@0 ELSE 0 END as count(*)]
02)--AggregateExec: mode=Final, gby=[], aggr=[__eager_m0_0]
03)----CoalescePartitionsExec
04)------AggregateExec: mode=Partial, gby=[], aggr=[__eager_m0_0]
05)--------HashJoinExec: mode=CollectLeft, join_type=RightSemi, accumulator=MinMaxLeftAccumulator, on=[(k@0, qty@0)]
06)----------CoalescePartitionsExec
07)------------FilterExec: k@0 = 1 OR k@0 = 2 OR k@0 = 3
08)--------------DataSourceExec: partitions=4, partition_sizes=[1, 0, 0, 0]
09)----------AggregateExec: mode=FinalPartitioned, gby=[qty@0 as qty], aggr=[__eager_p0_0]
10)------------RepartitionExec: partitioning=Hash([qty@0], 4), input_partitions=4
11)--------------AggregateExec: mode=Partial, gby=[qty@0 as qty], aggr=[__eager_p0_0]
12)----------------FilterExec: qty@0 = 1 OR qty@0 = 2 OR qty@0 = 3
13)------------------DataSourceExec: partitions=4, partition_sizes=[1, 1, 1, 0]

query I
SELECT count(*) FROM t WHERE qty IN (1, 2, 3) AND qty IN (SELECT k FROM d);
----
3175

query I
SELECT count(*) FROM t WHERE qty IN (1, 2, 3) AND qty IN (SELECT k FROM d WHERE k > 100);
----
0

# With the rule off the same queries return the same counts.
statement ok
set datafusion.optimizer.enable_eager_aggregation = false;

query IIIIII
SELECT
  (SELECT count(*) FROM t WHERE qty IN (1, 2, 3) AND qty NOT IN (SELECT NULL::INT)) AS a,
  (SELECT count(id) FROM t WHERE qty IN (1, 2, 3) AND qty NOT IN (SELECT NULL::INT)) AS b,
  (SELECT count(*) FROM t WHERE qty IN (1, 2, 3) AND qty NOT IN (SELECT qty FROM t WHERE id <= 50)) AS c,
  (SELECT count(*) FROM t WHERE qty IN (1, 2, 3) AND qty NOT IN (SELECT qty FROM t WHERE id <= 9)) AS d,
  (SELECT count(*) FROM t WHERE qty IN (1, 2, 3) AND qty IN (SELECT k FROM d)) AS e,
  (SELECT count(*) FROM t WHERE qty IN (1, 2, 3) AND qty IN (SELECT k FROM d WHERE k > 100)) AS f;
----
0 0 0 2117 3175 0

statement ok
set datafusion.explain.physical_plan_only = false;

statement ok
DROP TABLE t;

statement ok
DROP TABLE d;
