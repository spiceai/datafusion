SELECT "t"."c", "t"."d" FROM "public"."t" WHERE EXISTS (SELECT 1 FROM "other"."t" WHERE EXISTS (SELECT "t"."c", "t"."d" FROM "public"."t" WHERE EXISTS (SELECT "z"."k" FROM "z" WHERE ("z"."k" = "t"."c"))))
