SELECT (SELECT "outer_t"."id" AS "k") FROM (SELECT max("e"."id") AS "max(e.id)" FROM "e" WHERE ("e"."id" >= 0)) AS "derived_aggregate_1"
SELECT (SELECT "outer_t"."id" AS "k") FROM (SELECT max("e"."id") AS "max(e.id)" FROM "e" WHERE ("e"."id" < 0)) AS "derived_aggregate_1"
