SELECT "c", "d" FROM "public"."t" WHERE EXISTS (SELECT 1 FROM "other"."t" WHERE EXISTS (SELECT "a"."c", "a"."d", "c", "d" FROM "a" INNER JOIN "public"."t" ON ("a"."c" = "t"."c") WHERE EXISTS (SELECT "z"."k" FROM "z" WHERE ("z"."k" = "t"."c"))))
